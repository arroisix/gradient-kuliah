{
  "name": "Gradient Academy – Landing motion spec",
  "version": "2.0.0",
  "source": "deploy/academy/index.html (CSS keyframes + Web Animations API)",
  "figma": "https://www.figma.com/design/JXo93fsAo4yPvglUbRAVV8 → page \"Gradient Academy – Landing\" → section 06 Animasi",
  "units": {
    "time": "ms",
    "distance": "px",
    "angle": "deg"
  },
  "reducedMotion": "prefers-reduced-motion: reduce → all animations and transitions off, content shown in final state",
  "easings": {
    "easeOut": "cubic-bezier(.2, .8, .2, 1)",
    "easeBack": "cubic-bezier(.3, 1.45, .5, 1)",
    "glide": "cubic-bezier(.65, 0, .25, 1)",
    "tumble": "cubic-bezier(.3, .7, .3, 1)",
    "pop": "cubic-bezier(.3, 1.4, .5, 1)",
    "linear": "linear"
  },
  "intro": {
    "trigger": "window load AND document visible (+120ms); fallback start at 6000ms so the hero is never hidden",
    "totalDuration": 6600,
    "keyframesForFigmaStoryboard": [
      {
        "frame": "01 · 0.0s",
        "t": 0,
        "state": "Empty dark canvas, logo area scaled 1.7× in the screen centre."
      },
      {
        "frame": "02 · 0.15–0.95s",
        "t": 950,
        "state": "Three stripes draw in along the 24.1° axis, from their top ends, lightest first (130ms stagger)."
      },
      {
        "frame": "03 · 0.56–1.1s",
        "t": 1100,
        "state": "A fourth bar (#4313A3, 9% width of the triangle) draws in next to the stripes."
      },
      {
        "frame": "04 · 1.1–1.86s",
        "t": 1860,
        "state": "The bar unfolds sideways (scale across the axis 0.09 → 1.08 → 1) into the ∇/G triangle. Glow pulse."
      },
      {
        "frame": "05 · 1.45–2.15s",
        "t": 2150,
        "state": "Wordmark wipes in left→right (clip + blur). Ripples, logo settles from 1.7× to 1×."
      },
      {
        "frame": "06 · 2.1–3.8s",
        "t": 3800,
        "state": "Orbit rings draw, product badges arrive. Still centred."
      },
      {
        "frame": "07 · 3.8–4.9s",
        "t": 4900,
        "state": "System glides down to its resting place below the hero copy."
      },
      {
        "frame": "08 · 4.7–6.6s",
        "t": 6600,
        "state": "Headline, lede, CTAs, nav. Hero line starts rotating at 7.6s."
      }
    ],
