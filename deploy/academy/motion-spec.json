  "brandMotion": {
    "source": "Gradient Digital Playbook has no motion chapter; principles derived from its logo story",
    "principles": [
      "Stripes = progress step by step → staggered reveals, lightest stripe first (#C6BDFF → #925BFF → #612ACE → #4313A3)",
      "Arrow / nabla = guidance and direction → movement runs along the logo axis (24.1° from vertical)",
      "Colour gradient = gradual improvement → colour shifts use same-column gradients from the palette",
      "Calm, confident: ease-out for entrances, glide cubic-bezier(.65,0,.25,1) for transforms, small overshoot only on the final unfold"
    ],
    "axisDeg": 24.1
  },
  "performance": {
    "rules": [
      "Loop animations only use transform/opacity (compositor). No background-position, box-shadow or stroke-dashoffset loops.",
      "Sections more than 300px outside the viewport get .offscreen → animation-play-state: paused for all their loops.",
      "Starfield canvas: devicePixelRatio capped at 1.5; redraws every frame only while scrolling, otherwise ~30fps for the twinkle.",
      "No mask-image on the hero (bottom fade is an overlay); nav backdrop blur 14px; no backdrop-filter on repeated cards."
    ]
  },
  "notes": [
    "Buttons no longer show a \"+EXP\" burst on click. The only EXP pop left is the correct answer in the Mastery demo."
  ]
}