  "loops": [
    {
      "id": "orbit-spin",
      "target": "orbit (badge stays upright via counter-rotation)",
      "rotate": 360,
      "easing": "linear",
      "iterations": "infinite",
      "orbits": [
        {
          "product": "UTBK",
          "diameter": 0.46,
