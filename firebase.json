{
    "hosting": [
        {
            "target": "prod",
            "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
            "source": ".",
            "rewrites": [
                {
                    "source": "**",
                    "destination": "/:path*"
                }
            ]
        },
        {
            "target": "dev",
            "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
            "source": ".",
            "rewrites": [
                {
                    "source": "**",
                    "destination": "/:path*"
                }
            ]
        }
    ]
}
